{
  "version": "context-classifier-v2",
  "rules": [
    {
      "id": "dependency-lockfile",
      "role": "dependency_lockfile",
      "contextPolicy": "include_summary",
      "confidence": 0.98,
      "reason": "dependency lockfile",
      "match": {
        "filenameAny": [
          "package-lock.json",
          "npm-shrinkwrap.json",
          "pnpm-lock.yaml",
          "yarn.lock",
          "bun.lockb",
          "Cargo.lock",
          "go.sum",
          "Gemfile.lock",
          "poetry.lock",
          "Pipfile.lock",
          "composer.lock"
        ]
      }
    },
    {
      "id": "runtime-env-data",
      "role": "runtime_data",
      "contextPolicy": "exclude_noise",
      "confidence": 0.9,
      "reason": "environment/runtime data file",
      "match": {
        "filenameAny": [".env"],
        "filenameStartsWithAny": [".env."],
        "filenameEndsWithAny": [".env"]
      }
    },
    {
      "id": "source-of-truth-config",
      "role": "source_of_truth_config",
      "contextPolicy": "include_full",
      "confidence": 0.92,
      "reason": "source-of-truth configuration or schema file",
      "match": {
        "filenameAny": [
          "package.json",
          "schema.prisma",
          "tsconfig.json",
          "vite.config.ts",
          "vite.config.js",
          "tailwind.config.js",
          "tailwind.config.ts",
          "next.config.js",
          "next.config.ts",
          "astro.config.mjs",
          "svelte.config.js",
          "openapi.yaml",
          "openapi.yml",
          "openapi.json",
          "swagger.yaml",
          "swagger.yml",
          "swagger.json",
          "docker-compose.yml",
          "docker-compose.yaml",
          "Dockerfile",
          "Cargo.toml",
          "pyproject.toml",
          "go.mod",
          "composer.json",
          "Gemfile"
        ],
        "filenameStartsWithAny": ["tsconfig."],
        "extensionAny": ["proto", "graphql", "prisma"]
      }
    },
    {
      "id": "generated-reference-path",
      "role": "generated_reference",
      "contextPolicy": "include_summary",
      "confidence": 0.84,
      "reason": "path indicates generated/reference output",
      "match": {
        "pathSegmentAny": [
          "generated",
          "__generated__",
          "gen",
          ".generated",
          "codegen",
          ".codegen"
        ]
      }
    },
    {
      "id": "generated-reference-header",
      "role": "generated_reference",
      "contextPolicy": "include_summary",
      "confidence": 0.9,
      "reason": "file header marks generated output",
      "match": {
        "headerContainsAny": [
          "auto-generated",
          "autogenerated",
          "generated by",
          "this file was generated",
          "do not edit",
          "@generated",
          "<auto-generated"
        ]
      }
    },
    {
      "id": "build-output-file",
      "role": "build_output",
      "contextPolicy": "exclude_noise",
      "confidence": 0.92,
      "reason": "compiled/minified build artifact",
      "match": {
        "filenameEndsWithAny": [".min.js", ".min.css", ".bundle.js", ".map"]
      }
    }
  ]
}

